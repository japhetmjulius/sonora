@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #f4eff9;
  background: #100b17;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --bg: #100b17;
  --surface: #181120;
  --surface-2: #20172b;
  --border: rgba(232, 209, 164, .13);
  --gold: #e4c17c;
  --gold-light: #f4dba0;
  --muted: #a99db4;
  --white: #f8f4fc;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body { margin: 0; min-width: 320px; }
button, input { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button { cursor: pointer; }
a { color: inherit; text-decoration: none; }
button:focus-visible, a:focus-visible, input:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
::selection { background: #73522b; color: white; }

.app-shell { overflow: hidden; }
.topbar {
  height: 78px; padding: 0 7.2%; display: flex; align-items: center;
  justify-content: space-between; gap: 28px; background: rgba(16,11,23,.94);
  border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 50;
  backdrop-filter: blur(18px);
}
.brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: 3px; font-size: 18px; white-space: nowrap; }
.brand-mark { display: grid; place-items: center; color: var(--gold); width: 34px; height: 34px; border: 1px solid rgba(228,193,124,.45); border-radius: 50%; }
.brand-dot { color: var(--gold); }
.main-nav { display: flex; align-items: center; gap: 34px; height: 100%; }
.nav-link { color: #a99fb1; font-size: 13px; transition: color .2s; position: relative; display: flex; height: 100%; align-items: center; }
.nav-link:hover, .nav-link.active { color: var(--gold-light); }
.nav-link.active::after { content: ""; position: absolute; height: 2px; background: var(--gold); bottom: 0; left: 0; right: 0; }
.top-actions { display: flex; align-items: center; gap: 13px; }
.search-box { display: flex; align-items: center; gap: 9px; color: var(--muted); border: 1px solid var(--border); background: #17101f; border-radius: 8px; padding: 10px 12px; width: 220px; }
.search-box input { width: 100%; min-width: 0; background: transparent; color: var(--white); border: 0; outline: 0; font-size: 12px; }
.search-box input::placeholder { color: #82768c; }
.search-box kbd { font-size: 10px; color: #897e95; white-space: nowrap; border: 1px solid #403447; padding: 2px 4px; border-radius: 3px; }
.icon-button { border: 0; background: transparent; color: #d4cbdc; display: grid; place-items: center; width: 36px; height: 36px; position: relative; }
.notification span { position: absolute; right: 6px; top: 5px; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); }
.button { border: 1px solid transparent; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 13px 19px; font-size: 12px; font-weight: 700; border-radius: 6px; transition: transform .2s, background .2s, border-color .2s; }
.button:hover { transform: translateY(-2px); }
.button-gold { color: #21170c; background: linear-gradient(120deg, #f1d69a, #d6ad61); box-shadow: 0 5px 24px rgba(214,173,97,.1); }
.button-gold:hover { background: #f7dfaa; }
.button-small { padding: 10px 14px; }
.button-ghost { border-color: rgba(236,218,179,.27); background: rgba(255,255,255,.025); color: #f1e8f8; }
.button-ghost:hover { border-color: var(--gold); }
.mobile-toggle { display: none; }

.hero {
  position: relative; min-height: 620px; padding: 92px 10% 72px; display: grid;
  grid-template-columns: 1fr .9fr; align-items: center; gap: 45px;
  background: radial-gradient(ellipse at 78% 42%, #2a193a 0%, #181020 34%, #100b17 73%);
}
.hero::before { content: ""; position: absolute; inset: 0; opacity: .12; pointer-events: none; background-image: radial-gradient(#c6a15d 0.65px, transparent .65px); background-size: 23px 23px; mask-image: linear-gradient(90deg, transparent, black); }
.hero-glow { position: absolute; width: 320px; height: 320px; right: 14%; top: 19%; background: #6f4383; filter: blur(130px); opacity: .17; }
.hero-copy { position: relative; z-index: 2; max-width: 510px; }
.eyebrow { display: flex; align-items: center; gap: 8px; color: var(--gold); font-size: 10px; letter-spacing: 2.2px; font-weight: 700; }
.hero h1, .section-heading h2, .join-content h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; letter-spacing: -1.8px; }
.hero h1 { font-size: clamp(52px, 5.8vw, 78px); line-height: 1.08; margin: 25px 0 20px; }
.hero h1 span, .section-heading h2 span, .join-content h2 span { color: var(--gold); font-style: italic; }
.hero-description { max-width: 415px; color: #b7aabd; font-size: 14px; line-height: 1.9; }
.hero-actions { display: flex; gap: 12px; margin-top: 27px; flex-wrap: wrap; }
.hero-proof { display: flex; align-items: center; gap: 14px; margin-top: 43px; }
.avatar-stack { display: flex; padding-left: 3px; }
.mini-avatar { display: grid; place-items: center; width: 30px; height: 30px; border: 2px solid #17101f; border-radius: 50%; margin-left: -4px; font-size: 10px; color: white; font-weight: 700; }
.a1 { background: #a65d43; } .a2 { background: #506d82; } .a3 { background: #7d648f; } .a4 { background: #b38a4c; }
.hero-proof p { font-size: 11px; line-height: 1.7; color: #a89aaf; margin: 0; }
.hero-proof strong { color: #e7dce9; font-weight: 600; }
.hero-art { min-height: 425px; position: relative; display: flex; align-items: center; justify-content: center; }
.art-orbit { position: absolute; width: 400px; height: 400px; border: 1px solid rgba(226,195,132,.14); border-radius: 50%; }
.orbit-two { width: 340px; height: 340px; border-color: rgba(226,195,132,.09); }
.hero-image { position: absolute; background-position: center; background-size: cover; border: 1px solid rgba(228,193,124,.38); box-shadow: 0 25px 70px #09060d99; }
.hero-image-back { width: 230px; height: 300px; right: 2%; top: 8%; transform: rotate(8deg); background-image: url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=700&q=85'); opacity: .65; }
.hero-image-front { width: 255px; height: 335px; left: 13%; top: 11%; transform: rotate(-4deg); background-image: url('https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=800&q=85'); }
.hero-image-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, #100b1705 30%, #100b17df 100%); }
.hero-art-label { position: absolute; top: 16px; left: 17px; font-size: 8px; letter-spacing: 1.5px; color: white; display: flex; align-items: center; gap: 7px; }
.live-dot { width: 6px; height: 6px; background: var(--gold); border-radius: 50%; }
.hero-art-caption { position: absolute; bottom: 22px; left: 20px; right: 15px; }
.hero-art-caption > span { font-size: 8px; letter-spacing: 1.6px; color: var(--gold); }
.hero-art-caption h3 { font: 400 25px 'Playfair Display', Georgia, serif; margin: 8px 0; }
.hero-art-caption p { font-size: 10px; color: #ddd1df; }
.floating-note { position: absolute; display: flex; gap: 10px; align-items: center; padding: 12px 15px; border: 1px solid rgba(228,193,124,.25); background: #1b1325eF; border-radius: 7px; color: #e7ddec; font-size: 10px; box-shadow: 0 10px 35px #0005; z-index: 3; }
.floating-note svg, .note-star { color: var(--gold); }
.note-top { right: -2%; top: 20%; }
.note-bottom { left: -1%; bottom: 13%; }
.note-star { font-size: 18px; }
.hero-bottom-label { position: absolute; left: 10%; right: 10%; bottom: 25px; display: flex; align-items: center; gap: 15px; color: #81748b; font-size: 8px; letter-spacing: 1.5px; }
.hero-line { height: 1px; width: 45px; background: var(--gold); }

.section-wrap { max-width: 1250px; padding: 90px 7% 95px; margin: 0 auto; }
.discovery { scroll-margin-top: 70px; }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; }
.section-heading h2 { font-size: clamp(34px, 4vw, 46px); margin: 14px 0 8px; }
.section-heading p { color: var(--muted); font-size: 12px; margin: 0; }
.text-link { display: inline-flex; align-items: center; gap: 7px; color: var(--gold); font-size: 11px; font-weight: 600; white-space: nowrap; padding-bottom: 4px; }
.text-link:hover { color: var(--gold-light); }
.category-row { display: flex; gap: 9px; flex-wrap: wrap; margin-top: 35px; }
.category-pill { display: inline-flex; align-items: center; gap: 8px; padding: 11px 15px; border: 1px solid var(--border); background: transparent; color: #b5a9bf; border-radius: 5px; font-size: 11px; transition: .2s; }
.category-pill:hover { border-color: #8b7046; color: #fff; }
.category-pill.selected { color: #21170c; border-color: var(--gold); background: var(--gold); }
.feed-toolbar { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); margin-top: 32px; }
.feed-tabs { display: flex; gap: 24px; }
.feed-tab { border: 0; border-bottom: 2px solid transparent; padding: 14px 0; background: none; color: #96899f; font-size: 12px; }
.feed-tab.active-tab { color: var(--gold); border-color: var(--gold); }
.results-label { color: #8d8196; font-size: 10px; }
.creation-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-top: 25px; }
.creation-card { border: 1px solid var(--border); background: #17101f; border-radius: 8px; overflow: hidden; min-width: 0; transition: transform .25s, border-color .25s; }
.creation-card:hover { transform: translateY(-4px); border-color: rgba(228,193,124,.38); }
.creation-image { height: 220px; position: relative; background-size: cover; background-position: center; background-color: #33253b; }
.creation-image::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, #0e091b35, transparent 45%, #0e091b35); pointer-events: none; }
.type-tag, .featured-tag, .like-button, .play-button { position: absolute; z-index: 2; }
.type-tag { top: 13px; left: 13px; padding: 6px 9px; background: #120d1bd9; border: 1px solid #ffffff1e; border-radius: 4px; color: #f3e8f9; font-size: 9px; }
.like-button { top: 11px; right: 11px; width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid #ffffff36; background: #120d1b9c; color: white; border-radius: 50%; }
.like-button.is-liked { color: #ef8ca4; background: #401a2b; }
.play-button { top: 50%; left: 50%; transform: translate(-50%,-50%); width: 46px; height: 46px; display: grid; place-items: center; color: #25190d; background: var(--gold); border: 0; border-radius: 50%; }
.featured-tag { bottom: 12px; left: 13px; display: flex; gap: 5px; align-items: center; font-size: 8px; letter-spacing: 1px; color: var(--gold-light); }
.creation-body { padding: 17px 16px 15px; }
.creation-body h3 { margin: 0; font: 500 20px 'Playfair Display', Georgia, serif; }
.creation-description { color: #a99bb2; font-size: 11px; line-height: 1.7; min-height: 38px; margin: 9px 0 17px; }
.creation-footer { display: flex; justify-content: space-between; align-items: center; gap: 8px; border-top: 1px solid var(--border); padding-top: 13px; }
.creator-mini { display: flex; align-items: center; gap: 8px; min-width: 0; }
.creator-mini > div { min-width: 0; display: grid; gap: 3px; }
.creator-mini strong { font-size: 10px; font-weight: 600; white-space: nowrap; }
.creator-mini > div > span { font-size: 9px; color: #8e8199; }
.creator-avatar { display: grid; place-items: center; flex: 0 0 30px; height: 30px; border-radius: 50%; font-size: 10px; color: white; background: #554263; }
.creation-stats { display: flex; align-items: center; gap: 5px; font-size: 9px; color: #9b8da6; white-space: nowrap; }
.creation-stats svg { color: #d6b875; }
.empty-state { text-align: center; padding: 65px 20px; color: var(--muted); }
.empty-state h3 { color: var(--white); font: 24px 'Playfair Display', Georgia, serif; }
.empty-state p { font-size: 12px; margin-bottom: 20px; }

.creator-section { background: #17101f; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.creator-section .section-wrap { padding-top: 80px; padding-bottom: 90px; }
.creator-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 34px; }
.creator-card { position: relative; background: #1c1425; border: 1px solid var(--border); border-radius: 8px; padding: 0 20px 20px; }
.creator-cover { height: 95px; margin: 0 -20px; display: flex; align-items: center; justify-content: center; color: #f5d99a; background: radial-gradient(circle at 30% 40%, #72517c, #30213e 60%, #21172b); }
.creator-cover.avatar-two { background: radial-gradient(circle at 30% 40%, #4b7584, #233541 60%, #171e29); }
.creator-cover.avatar-three { background: radial-gradient(circle at 30% 40%, #8c6845, #49302e 60%, #241822); }
.creator-profile-avatar { position: relative; width: 52px; height: 52px; border-radius: 50%; border: 3px solid #1c1425; margin-top: -27px; display: grid; place-items: center; color: white; font-size: 17px; background: #785a85; }
.avatar-two { background-color: #3e7888; }
.avatar-three { background-color: #9b714c; }
.creator-info h3 { font: 500 19px 'Playfair Display', Georgia, serif; margin: 12px 0 4px; }
.creator-info p { color: var(--gold); font-size: 10px; margin: 0 0 9px; }
.creator-info > span { color: #a99bb2; font-size: 11px; }
.follow-button { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; margin-top: 18px; padding: 10px; border: 1px solid rgba(228,193,124,.32); background: transparent; color: var(--gold); border-radius: 5px; font-size: 11px; }
.follow-button:hover, .follow-button.following { background: #30243a; border-color: var(--gold); }

.join-section { position: relative; overflow: hidden; padding: 90px 8%; text-align: center; background: radial-gradient(ellipse at 50% 120%, #493052 0%, #1a1123 46%, #100b17 78%); border-bottom: 1px solid var(--border); }
.join-glow { position: absolute; width: 300px; height: 200px; background: #b58a4b; filter: blur(130px); opacity: .12; top: 20%; left: calc(50% - 150px); }
.join-content { position: relative; max-width: 530px; margin: 0 auto; }
.join-content .eyebrow { justify-content: center; }
.join-content h2 { font-size: clamp(43px, 6vw, 64px); line-height: 1.1; margin: 20px 0 14px; }
.join-content p { max-width: 430px; margin: 0 auto 25px; font-size: 12px; line-height: 1.9; color: #b6a8bf; }
.join-decoration { position: absolute; color: #e4c17c; opacity: .06; right: 7%; bottom: -20px; transform: rotate(-12deg); }
.footer { min-height: 100px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 25px 7.2%; background: #0d0812; }
.footer .brand { font-size: 15px; }
.footer .brand-mark { width: 30px; height: 30px; }
.footer > p { color: #8f8298; font-size: 11px; }
.footer-copy { color: #6e6276; font-size: 8px; letter-spacing: 1.2px; }

@media (min-width: 1450px) {
  .hero { padding-left: max(10%, calc((100vw - 1250px)/2)); padding-right: max(10%, calc((100vw - 1250px)/2)); }
}
@media (max-width: 1050px) {
  .topbar { padding: 0 4%; gap: 16px; }
  .main-nav { gap: 20px; }
  .search-box { width: 180px; }
  .hero { padding-left: 6%; padding-right: 6%; gap: 20px; }
  .hero-bottom-label { left: 6%; right: 6%; }
  .hero-image-front { left: 8%; }
  .note-top { right: -2%; }
  .creation-grid { gap: 14px; }
  .creation-body { padding: 14px 12px; }
  .creation-image { height: 190px; }
  .creation-stats { font-size: 8px; }
}
@media (max-width: 760px) {
  .topbar { height: 68px; padding: 0 5%; }
  .brand { font-size: 16px; letter-spacing: 2px; }
  .brand-mark { width: 30px; height: 30px; }
  .main-nav { display: none; position: absolute; top: 67px; left: 0; right: 0; height: auto; padding: 18px 5%; flex-direction: column; align-items: stretch; gap: 0; background: #140e1c; border-bottom: 1px solid var(--border); }
  .main-nav.nav-open { display: flex; }
  .nav-link { padding: 14px 0; height: auto; }
  .nav-link.active::after { display: none; }
  .top-actions { gap: 7px; }
  .search-box { width: min(36vw, 180px); padding: 9px; }
  .search-box kbd, .notification, .button-small { display: none; }
  .mobile-toggle { display: grid; }
  .hero { grid-template-columns: 1fr; padding: 65px 7% 68px; gap: 10px; }
  .hero h1 { font-size: clamp(55px, 12vw, 75px); }
  .hero-description { max-width: 470px; }
  .hero-proof { margin-top: 30px; }
  .hero-art { min-height: 390px; margin: 8px auto 0; width: min(100%, 430px); }
  .art-orbit { width: 340px; height: 340px; }
  .orbit-two { width: 285px; height: 285px; }
  .hero-image-front { width: 220px; height: 295px; left: 15%; }
  .hero-image-back { width: 195px; height: 260px; right: 7%; }
  .note-top { right: 0; top: 15%; }
  .note-bottom { left: 0; bottom: 8%; }
  .hero-bottom-label { bottom: 23px; }
  .section-wrap { padding: 65px 5% 70px; }
  .section-heading { align-items: start; }
  .section-heading h2 { font-size: 37px; }
  .section-heading .text-link { margin-top: 35px; }
  .category-row { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 10px; margin-right: -5%; scrollbar-width: thin; }
  .category-pill { white-space: nowrap; }
  .creation-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px; }
  .creation-image { height: 180px; }
  .creation-body h3 { font-size: 18px; }
  .creation-description { min-height: 55px; }
  .creation-footer { align-items: start; flex-direction: column; }
  .creation-stats { padding-left: 2px; }
  .creator-grid { grid-template-columns: 1fr; gap: 15px; }
  .creator-card { display: grid; grid-template-columns: 58px 1fr auto; align-items: center; gap: 12px; padding: 15px; }
  .creator-cover { display: none; }
  .creator-profile-avatar { grid-column: 1; grid-row: 1; margin: 0; }
  .creator-info { grid-column: 2; grid-row: 1; }
  .creator-info h3 { font-size: 17px; margin-top: 0; }
  .creator-info p { margin-bottom: 5px; }
  .follow-button { grid-column: 3; grid-row: 1; width: auto; padding: 9px; margin: 0; }
  .join-section { padding: 75px 7%; }
  .footer { padding: 25px 5%; flex-wrap: wrap; }
  .footer > p { display: none; }
}
@media (max-width: 430px) {
  .search-box { width: 125px; }
  .search-box input { font-size: 11px; }
  .hero { padding-top: 50px; }
  .hero h1 { font-size: 53px; }
  .hero-actions { align-items: stretch; }
  .hero-actions .button { padding: 12px; font-size: 11px; }
  .hero-art { min-height: 340px; }
  .hero-image-front { width: 190px; height: 255px; left: 12%; }
  .hero-image-back { width: 165px; height: 225px; right: 6%; }
  .art-orbit { width: 290px; height: 290px; }
  .orbit-two { width: 245px; height: 245px; }
  .floating-note { padding: 9px 10px; font-size: 9px; }
  .section-heading h2 { font-size: 32px; }
  .section-heading .text-link { font-size: 10px; }
  .creation-grid { grid-template-columns: 1fr; gap: 17px; }
  .creation-image { height: 235px; }
  .creation-footer { flex-direction: row; align-items: center; }
  .creation-description { min-height: 0; }
  .feed-tabs { gap: 17px; }
  .footer-copy { font-size: 7px; }
}
